{:paths ["bb"]
 :deps {io.github.babashka/deps-deploy {:mvn/version "0.0.1"
                                        :exclusions [org.babashka/http-client]}}
 :tasks
 {test:clj {:doc "Run jvm tests, optionally specify clj-version (ex. :clj-1.10 :clj-1.11(default) or :clj-all)"
            :task test-clj/-main}

  test:bb {:extra-paths ["src" "test"]
           :extra-deps {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.0" :git/sha "b3fd0d2"}
                        io.github.borkdude/deflet {:mvn/version "0.1.0"}}
           :task cognitect.test-runner/-main}

  quickdoc {:doc "Invoke quickdoc"
            :extra-deps {io.github.borkdude/quickdoc
                         {:git/sha "e4f08eb5b1882cf0bffcbb7370699c0a63c9fd72"}}
            :task (exec 'quickdoc.api/quickdoc)
            :exec-args {:git/branch "main"
                        :github/repo "https://github.com/babashka/http-client"
                        :source-paths ["src/babashka/http_client.clj"
                                       "src/babashka/http_client/interceptors.clj"
                                       "src/babashka/http_client/websocket.clj"]}}
  refresh-version {:requires ([babashka.fs :as fs]
                              [clojure.string :as str])
                   :task (let [version (-> (slurp "deps.edn")
                                           clojure.edn/read-string
                                           :aliases :neil :project :version)]
                           (fs/update-file "src/babashka/http_client/internal/version.clj"
                                           (fn [contents]
                                             (str/replace contents (re-pattern "#_:version(.*)")
                                                          (fn [[_ match]]
                                                            (str "#_:version " (pr-str version)))))))}

  bump-release {:doc "Bump release counter and turn the Unreleased changelog header into the new version"
                :requires ([clojure.string :as str]
                           [utils])
                :task (let [old-version (utils/format-version)
                            changelog (slurp "CHANGELOG.md")]
                        (when-not (str/includes? changelog "## Unreleased")
                          (throw (ex-info "CHANGELOG.md has no ## Unreleased header" {})))
                        (utils/bump-version)
                        (run 'refresh-version)
                        (let [new-version (utils/format-version)]
                          (spit "CHANGELOG.md" (str/replace-first changelog
                                                                 "## Unreleased"
                                                                 (str "## " new-version " (" (java.time.LocalDate/now) ")")))
                          (spit "README.md" (str/replace (slurp "README.md")
                                                         old-version
                                                         new-version))
                          (shell "git add deps.edn src/babashka/http_client/internal/version.clj README.md CHANGELOG.md")
                          (shell "git commit -m" (str "v" new-version))
                          (shell "git tag" (str "v" new-version))
                          (shell "git push --tags")))}

  publish {:doc "Publish to clojars, then push"
           :depends [refresh-version]
           :extra-paths ["."]
           :exec-fn tasks/publish}}}
